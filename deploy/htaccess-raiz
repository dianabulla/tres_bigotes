RewriteEngine On
RewriteBase /
DirectoryIndex index.php dist/index.html

# El código y los secretos no se publican.
RewriteRule ^(\.env|config|controllers|models|database|api|view|node_modules|docs|\.cursor)(/|$) - [F,L]

# La API sigue en public/ y responde JSON. END evita que la página se coma esta ruta.
RewriteRule ^public/ - [END]

# Archivos de la interfaz generada.
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.*)$ dist/$1 [L]

# Raíz y rutas de React.
RewriteRule ^$ dist/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . dist/index.html [L]
